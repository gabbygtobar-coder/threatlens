# Public Supabase values only. Never put SUPABASE_SERVICE_ROLE_KEY here
# (or anywhere in the Next.js client bundle). RLS enforces per-user access.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# FastAPI detection engine (stateless). The browser calls this origin directly.
# Local: http://127.0.0.1:8000
# Vercel: set Root Directory to `web` and use a public FastAPI URL (docs/deploy.md).
# 127.0.0.1 will not work from visitors' browsers. If unset, Analyze/Rules show
# an error — no mock engine.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Do NOT add OPENAI_API_KEY or NEXT_PUBLIC_OPENAI_API_KEY here.
# Explain-only reads the key on the FastAPI service only (api/.env / Render).
