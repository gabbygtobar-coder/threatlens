# Public Supabase values only. Never put SUPABASE_SERVICE_ROLE_KEY here
# (or anywhere in the Next.js client bundle). RLS enforces per-user access.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# FastAPI detection engine (stateless). Browser calls this directly.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
