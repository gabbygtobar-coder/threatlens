# Comma-separated browser origins allowed to call this API (CORS).
# Local defaults are used if unset. That is intentional: a hosted API will NOT
# accept the Vercel origin until you set it here and restart.
# Production: list exact https origins, e.g. https://threatlens.vercel.app
# Do not use * — FastAPI would reflect any Origin, which is a footgun if cookies
# are added later.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# In-memory POST /parse, /detect, and /explain limit per client IP (not Redis,
# not shared across replicas). GET /health and GET /rules are not limited.
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW_SECONDS=60

# Optional explain-only. If unset, POST /explain returns 503 and the UI does
# not invent an explanation. Detection still works. This key stays on the API.
# Never copy it into the Next.js app or a NEXT_PUBLIC_* Vercel variable.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
